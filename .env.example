# Copy to .env and adjust. No secrets are required for local use; never commit a real .env.

# --- artifacts / storage ---
NEWSREC_ARTIFACTS_DIR=artifacts
# Empty -> artifacts/CURRENT
NEWSREC_ARTIFACT_VERSION=
NEWSREC_DATABASE_URL=sqlite:///data/newsrec.db

# --- Redis cache (set to "disabled" to turn caching off; the service then serves uncached) ---
# Empty values anywhere in this file mean "use the default".
NEWSREC_REDIS_URL=redis://localhost:6379/0
NEWSREC_REDIS_TIMEOUT_S=0.25
NEWSREC_CACHE_PREFIX=newsrec
NEWSREC_PROFILE_CACHE_TTL_S=3600
NEWSREC_RECOMMENDATION_CACHE_TTL_S=300

# --- request bounds ---
NEWSREC_DEFAULT_LIMIT=5
NEWSREC_MAX_LIMIT=50
NEWSREC_MAX_HISTORY=200

# --- retrieval / post-ranking ---
NEWSREC_RETRIEVAL_SIMILAR=150
NEWSREC_RETRIEVAL_POPULAR=50
# Optional exposure-recency eligibility window in hours (empty = whole catalogue)
NEWSREC_CANDIDATE_MAX_AGE_HOURS=
# exact | faiss (faiss must be installed separately)
NEWSREC_INDEX_BACKEND=exact
NEWSREC_DEDUP_THRESHOLD=0.9
NEWSREC_MAX_PER_CATEGORY=
# Logical "now" for the exposure-age feature (empty = popularity snapshot time)
NEWSREC_REFERENCE_TIME=

# --- logging ---
NEWSREC_LOG_LEVEL=INFO
NEWSREC_JSON_LOGS=true
